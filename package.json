{
    "name": "@particle-academy/job-board",
    "version": "0.1.0",
    "description": "Job board UX — public listings, employer posting management, and candidate applications, built on Fancy UI primitives.",
    "keywords": [
        "jobs",
        "job-board",
        "hiring",
        "react",
        "tailwind",
        "fancy-ui",
        "particle-academy"
    ],
    "homepage": "https://github.com/Particle-Academy/job-board",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Particle-Academy/job-board.git"
    },
    "bugs": "https://github.com/Particle-Academy/job-board/issues",
    "license": "MIT",
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "lint": "tsc --noEmit",
        "clean": "rm -rf dist",
        "prepublishOnly": "tsup",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "peerDependencies": {
        "@particle-academy/react-fancy": ">=4",
        "axios": ">=1",
        "react": "^19.0.0",
        "react-dom": "^19.0.0"
    },
    "devDependencies": {
        "@particle-academy/react-fancy": "^4.16.0",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "axios": "^1.11.0",
        "jsdom": "^29.1.1",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "tsup": "^8.0.0",
        "typescript": "^5.7.0",
        "vitest": "^3.2.7"
    },
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=22"
    }
}
